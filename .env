PGHOST=127.0.0.1
PGPORT=5432
PGUSER=singer
PGPASSWORD=123456
PGDATABASE=llm_test

PG_MIN_CONN=1
PG_MAX_CONN=10

GEN_SLOW_SQL_COUNT=500
GEN_SLOW_SQL_TARGET_SECONDS=2
GEN_SLOW_SQL_ACCEPT_MIN_RATIO=0.8
GEN_SLOW_SQL_ACCEPT_MAX_RATIO=3
GEN_SLOW_SQL_TIMEOUT_RATIO=5
GEN_SLOW_SQL_FROM_MODE=join
