DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
EXPANDER_SEED_FILE=RLSQL_{database}_pg_{seed_target}.log
EXPANDER_SUMMARY_FILE=pool/db_summary_{database}_compact.json
EXPANDER_OUTPUT_FILE=output/{database}_final_workload.sql
EXPANDER_RECORDS_FILE=output/{database}_final_workload_records.jsonl
EXPANDER_RUN_LOG=agent/expander/{database}_expander_run.log
EXPANDER_TIMING_LOG=agent/expander/{database}_sql_timing.log
EXPANDER_CHECKPOINT_FILE=output/{database}_live_checkpoint.json
EXPANDER_RESUME_RUN=false
PLANNER_PATHS_FILE=output/{database}_planner_paths.json
PLANNER_CONSTRAINTS_FILE=output/{database}_planner_constraints.json
PLANNER_MAX_PATHS=60
LIVE_SEEDS_PER_TURN=1
LIVE_MAX_SEEDS_PER_PATH=10
LIVE_GENERATOR_ATTEMPTS_PER_TURN=15
LIVE_MAX_NO_GAIN_TURNS=2
EXPANDER_TARGET_COUNT=200
EXPANDER_CANDIDATES_PER_REQUEST=2
EXPANDER_MAX_ROUNDS_PER_SEED=3
EXPANDER_REQUEST_TIMEOUT_SECONDS=90
EXPANDER_SAMPLE_VALUE_LIMIT=4
EXPANDER_TARGET_SECONDS=2
EXPANDER_ACCEPT_MIN_RATIO=0.8
EXPANDER_ACCEPT_MAX_RATIO=3
EXPANDER_SLOW_ACCEPT_MAX_RATIO=5
EXPANDER_TIMEOUT_RATIO=6
EXPANDER_VALIDATE_RUNS=1
EXPANDER_MAX_RUNTIME_CV=0.15
EXPANDER_MAX_RUNTIME_SPREAD=1.5
